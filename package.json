{
  "name": "kata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.js",
    "dev:desktop": "pnpm --filter @kata/desktop tauri dev",
    "dev:web": "pnpm --filter @kata/web dev",
    "build:desktop": "pnpm --filter @kata/desktop tauri build",
    "build:web": "pnpm --filter @kata/web build",
    "preview:web": "pnpm --filter @kata/web preview",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run"
  },
  

  "pnpm": {
    "overrides": {
      "@types/node": "^20.19.43"
    }
  },

  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^5.0.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@8.15.0"
}
